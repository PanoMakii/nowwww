# ==============================================================================
# Recip52 Production Environment Blueprint (.env.production)
# ==============================================================================

# --- Frontend Application (Vite Build Arguments) ---
# The publicly accessible URL of your backend Express API
VITE_API_BASE_URL=https://api.yourdomain.com/api

# --- Backend Application Runtime ---
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=https://yourdomain.com,https://app.yourdomain.com,https://recip52.vercel.app

# --- Managed PostgreSQL Database (Neon, Supabase, AWS RDS) ---
# SSL mode require is strongly recommended in cloud production
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST]:5432/recip52_db?sslmode=require
PGSSLMODE=require

# --- Managed Redis Cache (Upstash, AWS ElastiCache) ---
# Use TLS rediss:// protocol for production cloud Redis instances
REDIS_URL=rediss://default:[YOUR-TOKEN]@[YOUR-UPSTASH-INSTANCE].upstash.io:6379

# --- Authentication & Cryptography (JWT) ---
# Generate high-entropy 256-bit secrets via: openssl rand -hex 64
JWT_SECRET=replace_with_64_byte_cryptographically_secure_random_hex_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_separate_64_byte_random_hex_key
JWT_REFRESH_EXPIRES_IN=30d

# --- Artificial Intelligence & Vision Engine ---
OPENAI_API_KEY=sk-proj-your-production-openai-api-key

# --- Monitoring & Observability (Optional) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
LOG_LEVEL=info
